# Zenme Local defaults.
# Keep this as "local" for offline, single-user desktop/local development.
ZENME_STORAGE_DRIVER=local
ZENME_DATA_DIR=./data/local

# Optional server-only AI provider settings. Do not expose these with NEXT_PUBLIC_.
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENROUTER_API_KEY=your-openrouter-api-key

# Server-only OCR settings. Do not expose these with NEXT_PUBLIC_.
# READING_OCR_PROVIDER can be "local-model" or "tencent".
READING_OCR_PROVIDER=local-model
# Optional comma-separated allowlist. If omitted, only READING_OCR_PROVIDER is allowed.
# Examples: "local-model" or "local-model,tencent".
READING_OCR_ALLOWED_PROVIDERS=local-model
TENCENT_CLOUD_SECRET_ID=your-tencent-cloud-secret-id
TENCENT_CLOUD_SECRET_KEY=your-tencent-cloud-secret-key
TENCENT_CLOUD_REGION=ap-guangzhou
# Used only when READING_OCR_PROVIDER=local-model. Zenme currently uses
# tesseract.js with local chi_sim + eng data packages.
LOCAL_MODEL_OCR_CACHE_PATH=./data/ocr-models/tesseract-cache-v2
LOCAL_MODEL_OCR_LANG_PATH=./data/ocr-models/tessdata
LOCAL_MODEL_OCR_TIMEOUT_MS=90000

# Optional Supabase mode. Leave these commented for local-first use.
# ZENME_STORAGE_DRIVER=supabase
# NEXT_PUBLIC_SUPABASE_URL=your-project-url
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional smoke-test users for `npm run smoke:supabase`.
# Use two confirmed Supabase Auth test users with different owned projects.
ZENME_E2E_USER_A_EMAIL=user-a@example.com
ZENME_E2E_USER_A_PASSWORD=replace-with-test-password
ZENME_E2E_USER_B_EMAIL=user-b@example.com
ZENME_E2E_USER_B_PASSWORD=replace-with-test-password
