{
  "name": "zenme-local",
  "productName": "Zenme",
  "description": "Zenme local-first desktop app",
  "private": true,
  "version": "0.1.2",
  "license": "MIT",
  "author": "Zenme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alkaiddiamond/zenme-local.git"
  },
  "homepage": "https://github.com/alkaiddiamond/zenme-local#readme",
  "bugs": {
    "url": "https://github.com/alkaiddiamond/zenme-local/issues"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "packageManager": "npm@11.13.0",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "desktop:dev": "node desktop/scripts/run-dev-electron.cjs desktop/main.cjs",
    "desktop:demo": "node scripts/capture-readme-screenshots.cjs --demo",
    "desktop:pack": "node desktop/scripts/verify-standalone-runtime.cjs && electron-builder --dir",
    "desktop:dist:win": "node desktop/scripts/verify-standalone-runtime.cjs && electron-builder --win nsis --x64 --publish never",
    "desktop:prepare:mac": "bash desktop/scripts/prepare-macos-icon.sh",
    "desktop:pack:mac:intel": "npm run desktop:prepare:mac && node desktop/scripts/verify-standalone-runtime.cjs && electron-builder --mac dir --x64 --publish never",
    "desktop:dist:mac:intel": "npm run desktop:prepare:mac && node desktop/scripts/verify-standalone-runtime.cjs && electron-builder --mac dmg zip --x64 --publish never",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run && node --test desktop/*.node-test.cjs",
    "check": "npm run lint && npm test",
    "verify": "npm run check && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "licenses:generate": "node scripts/generate-third-party-licenses.cjs",
    "licenses:check": "npm run licenses:generate && git diff --exit-code -- THIRD_PARTY_LICENSES.md",
    "screenshots:readme": "npm run build && npm run desktop:pack && node scripts/capture-readme-screenshots.cjs",
    "desktop:smoke": "node desktop/smoke-packaged-app.cjs",
    "desktop:perf": "node desktop/performance-packaged-app.cjs --profile=all",
    "desktop:perf:assert": "node desktop/performance-packaged-app.cjs --profile=large --assert",
    "release:check": "npm run verify && npm run audit:prod && npm run licenses:check && npm run desktop:pack && npm run desktop:smoke"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@xyflow/react": "^12.11.1",
    "adm-zip": "0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.47",
    "lucide-react": "^0.511.0",
    "music-metadata": "^11.14.0",
    "next": "16.2.11",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "tesseract.js": "^7.0.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "postcss": "8.5.22",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "build": {
    "afterPack": "desktop/scripts/verify-packaged-runtime.cjs",
    "appId": "local.zenme.desktop",
    "productName": "Zenme",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "!node_modules/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "LICENSE",
      "package.json",
      "THIRD_PARTY_LICENSES.md"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "standalone/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "icon": "public/brand/icons/zenme-logo-256.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": "dir"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "desktop/installer.nsh",
      "oneClick": false
    }
  }
}
