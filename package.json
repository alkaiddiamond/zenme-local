{
  "name": "zenme-local",
  "productName": "Zenme",
  "description": "Zenme local-first desktop app",
  "private": true,
  "version": "0.1.0",
  "author": "Zenme",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:pack": "electron-builder --dir",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@xyflow/react": "^12.11.1",
    "adm-zip": "^0.5.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.511.0",
    "next": "^16.2.10",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "tesseract.js": "^7.0.0",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "build": {
    "asarUnpack": [
      ".next/**/*",
      "next.config.ts",
      "node_modules/**/*",
      "package.json",
      "public/**/*"
    ],
    "appId": "local.zenme.desktop",
    "productName": "Zenme",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      {
        "from": ".next",
        "to": ".next",
        "filter": [
          "**/*",
          "!cache/**/*",
          "!dev/**/*"
        ]
      },
      "app/**/*",
      "components/**/*",
      "desktop/**/*",
      "lib/**/*",
      "next.config.ts",
      "package.json",
      "public/**/*",
      "scripts/**/*"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "icon": "public/brand/icons/zenme-logo-256.png",
      "target": "dir"
    },
    "mac": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    }
  }
}
